{
  "name": "tolt",
  "version": "1.0.0",
  "description": "拾遗潮 · Tide of Lost Things —— 原创视觉小说",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tolt.game",
    "productName": "拾遗潮",
    "directories": { "output": "dist-app" },
    "files": [
      "electron-main.js",
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "manifest.json",
      "icon-512.png",
      "sw.js"
    ],
    "mac": { "target": ["dmg", "zip"], "icon": "icon-512.png" },
    "win": { "target": ["nsis", "portable"], "icon": "icon-512.png" },
    "linux": { "target": ["AppImage"], "icon": "icon-512.png" }
  }
}
